[Unit]
Description=Airline API
After=network.target postgresql.service

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/airline/backend
Environment=ATHENA_DB=airline_analytics
Environment=ATHENA_OUTPUT=s3://BUCKET/athena-results/
Environment=AWS_REGION=us-east-1
ExecStart=/home/ec2-user/airline/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80 --workers 2
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always

[Install]
WantedBy=multi-user.target
